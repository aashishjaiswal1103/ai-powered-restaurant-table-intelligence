# ==============================================================================
# Restaurant Intelligence & Operations System - Environment Configuration
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000

# RushDB Configuration
RUSHDB_API_KEY=your_rushdb_api_key_here
RUSHDB_BASE_URL=https://api.rushdb.com
RUSHDB_DATABASE_ID=restaurant_ops_dev

# Computer Vision Configuration
CAMERA_SOURCE_TYPE=file
CAMERA_SOURCE=vision/test_assets/sample_restaurant.mp4
VISION_MODEL_PATH=yolov8n.pt
VISION_CONFIDENCE_THRESHOLD=0.40
VISION_FRAME_RATE=5

# Lifecycle Timing Parameters (seconds)
ARRIVAL_CONFIRMATION_SECONDS=5
DEPARTURE_CONFIRMATION_SECONDS=30

# CORS / Frontend URL
FRONTEND_ORIGIN=http://localhost:5173
